{
    email your-email@example.com
    auto_https off
}

# Web Dashboard & API
# Tunnel terminates TLS at Cloudflare; upstream hop is HTTP. Tell the app the client used HTTPS
# so signed stream URLs and api_base_url use https:// (avoids mixed-content on <audio src>).
http://e-music.win, http://api.e-music.win {
    reverse_proxy backend:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }
}


# E-Call — same idea as e-music: tunnel is HTTP, app should see HTTPS
http://call.e-music.win {
    reverse_proxy pi-nginx-1:80 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }
}

# Optional until LiveKit exists — avoids opaque 502s
# When LiveKit runs on Docker as service livekit on the same networks as Caddy, replace the conf block with:
# http://conf.e-music.win {
#     reverse_proxy livekit:7880 {
#         header_up X-Forwarded-Proto https
#         header_up X-Forwarded-Host {host}
#     }
# }
http://conf.e-music.win {
    respond "LiveKit not deployed yet" 503
}