# Domain Configuration
DOMAIN=e-music.win
API_SUBDOMAIN=api.e-music.win
PUBLIC_API_BASE_URL=https://e-music.win

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://api.e-music.win/api/v1/auth/callback

# Security
JWT_SECRET=your_random_jwt_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated Google/emails that always get admin (protect /system/* ops)
ADMIN_EMAILS=your.admin@gmail.com
# Optional: separate secret for signed stream URLs (defaults to JWT_SECRET)
# STREAM_URL_SIGNING_SECRET=
STREAM_URL_TTL_SECONDS=600
# Public API origin (no path); used for signed stream URLs and GET /api/v1/config
# Use the same host users see in the browser (https). Examples:
# PUBLIC_API_BASE_URL=https://e-music.win
# PUBLIC_API_BASE_URL=https://api.e-music.win

# Database
DATABASE_URL=sqlite:////app/db/myspotify.db

# Storage Path (Host specific)
# Windows example: R:\e-music
# Linux example: /share/e-music
MUSIC_PATH=/share/e-music
