# Domain Configuration
DOMAIN=e-music.win
API_SUBDOMAIN=api.e-music.win
PUBLIC_API_BASE_URL=https://e-music.win

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://api.e-music.win/api/v1/auth/callback

# Security
JWT_SECRET=your_random_jwt_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated Google/emails that always get admin (protect /system/* ops)
ADMIN_EMAILS=your.admin@gmail.com
# Optional: separate secret for signed stream URLs (defaults to JWT_SECRET)
# STREAM_URL_SIGNING_SECRET=
STREAM_URL_TTL_SECONDS=600
# Public API origin (no path); used for signed stream URLs and GET /api/v1/config
# Use the same host users see in the browser (https). Examples:
# PUBLIC_API_BASE_URL=https://e-music.win
# PUBLIC_API_BASE_URL=https://api.e-music.win

# Database
DATABASE_URL=sqlite:////app/db/myspotify.db

# Storage — host folder that contains library/, cache/, and db/ (used only by docker-compose
# volume lines). Inside the container the app uses /app/library, /app/cache, /app/db (set in
# docker-compose.yml). Optional alias: MUSIC_HOST_ROOT (same meaning as MUSIC_PATH here).
# Windows: MUSIC_PATH=R:\e-music
# Raspberry Pi: MUSIC_PATH=/share/e-music
MUSIC_PATH=/share/e-music

# AI Shuffle (Groq — free tier: ~14k req/day, no credit card required)
# Get your key at: console.groq.com
# Model: llama-3.1-8b-instant (fast) or llama-3.3-70b-versatile (higher quality)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant


GEMINI_API_KEY=your_gemini_api_key_here

# AI Gemini is used for Humming recognition (aka Shazam)
#GEMINI_MODEL=gemini-2.0-flash # this model requires billing (it is not free)
